# Example only. Each installed project should set its real values locally.
# Copy required values to .env.local or define them in the runtime environment.
# Never commit passwords, secret keys or production credentials.

# Symfony
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

# Database configured by the SymSvel Setup Wizard.
# Replace with the selected engine, host, DB name and server version.
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/database?serverVersion=17&charset=utf8"
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/database?serverVersion=8.0&charset=utf8mb4"
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Messenger (DB-backed default)
MESSENGER_TRANSPORT_DSN="doctrine://default?auto_setup=0"

# Mail transport (configure when enabled)
MAILER_DSN=
MAILTRAP_DSN=
# Example: MAILTRAP_DSN="smtp://sandbox.smtp.mailtrap.io:2525"

# Local CORS default. Configure an explicit production allowlist for deployment.
SYMSVEL_CORS_ALLOW_ORIGIN='^https?://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?$'
