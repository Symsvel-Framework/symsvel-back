# Valeurs minimales du bootstrap : jamais une configuration de production.
# Le wizard PHP natif écrit .env.local (non versionné) AVANT le démarrage HTTP de Symfony.
# Tant que setup.json n'est pas completed, public/index.php interdit le runtime.
APP_ENV=dev
APP_DEBUG=0
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
DATABASE_URL="sqlite:///%kernel.project_dir%/var/bootstrap.sqlite"
MESSENGER_TRANSPORT_DSN="doctrine://default?auto_setup=0"
MAILER_DSN="null://null"
SYMSVEL_CORS_ALLOW_ORIGIN='^$'
CORS_ALLOW_ORIGIN='^$'
