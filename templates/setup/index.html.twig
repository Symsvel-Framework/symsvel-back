{% extends 'base.html.twig' %}
{% block title %}Installation SymSvel{% endblock %}
{% block body %}
<main style="max-width:42rem;margin:5rem auto;font:1rem system-ui,sans-serif;padding:1rem">
  <h1>Installation SymSvel</h1>
  <p>Phase 1 sur 2 : configurez le projet et sa connexion à la base de données. La base et les migrations seront préparées avant la création du premier administrateur.</p>
  {% for message in app.flashes('setup_error') %}<p role="alert">{{ message }}</p>{% endfor %}
  <form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('symsvel_setup') }}">
    <label for="project_name">Nom du projet</label>
    <input id="project_name" name="project_name" type="text" maxlength="120" required autocomplete="organization" style="display:block;width:100%;padding:.7rem;margin:.5rem 0 1rem">
    <label for="local_domain">Domaine local du projet (sans protocole ni port)</label>
    <input id="local_domain" name="local_domain" type="text" maxlength="253" placeholder="xt.localhost" required autocomplete="off" style="display:block;width:100%;padding:.7rem;margin:.5rem 0 1rem">
    <p>Utilisé par le projet après installation. Ne saisissez pas l’adresse temporaire 127.0.0.1 du Wizard.</p>
    <fieldset>
      <legend>Connexion à la base de données</legend>
      <label for="db_driver">SGBD</label>
      <select id="db_driver" name="db_driver" style="display:block;width:100%;padding:.7rem;margin:.5rem 0 1rem">
        <option value="postgresql">PostgreSQL</option>
        <option value="mysql">MySQL</option>
        <option value="mariadb">MariaDB</option>
        <option value="sqlite">SQLite</option>
      </select>
      <div id="server_fields">
      <label for="db_host">Hôte</label>
      <input id="db_host" name="db_host" type="text" value="127.0.0.1" maxlength="253" required autocomplete="off" style="display:block;width:100%;padding:.7rem;margin:.5rem 0 1rem">
      <label for="db_port">Port</label>
      <input id="db_port" name="db_port" type="number" min="1" max="65535" value="5432" required style="display:block;width:100%;padding:.7rem;margin:.5rem 0 1rem">
      <label for="db_name">Nom de la base</label>
      <input id="db_name" name="db_name" type="text" maxlength="128" required autocomplete="off" style="display:block;width:100%;padding:.7rem;margin:.5rem 0 1rem">
      <label for="db_user">Utilisateur</label>
      <input id="db_user" name="db_user" type="text" maxlength="128" required autocomplete="off" style="display:block;width:100%;padding:.7rem;margin:.5rem 0 1rem">
      <label for="db_password">Mot de passe (facultatif)</label>
      <input id="db_password" name="db_password" type="password" autocomplete="new-password" style="display:block;width:100%;padding:.7rem;margin:.5rem 0 1rem">
      </div>
      <div id="sqlite_fields" hidden>
        <label for="db_sqlite_path">Fichier SQLite relatif au backend</label>
        <input id="db_sqlite_path" name="db_sqlite_path" value="var/app.sqlite" style="display:block;width:100%;padding:.7rem;margin:.5rem 0 1rem">
      </div>
    </fieldset>
    <button type="submit">Préparer la base et poursuivre</button>
  </form>
  <script>
    const driver = document.getElementById('db_driver');
    const serverFields = document.getElementById('server_fields');
    const sqliteFields = document.getElementById('sqlite_fields');
    const port = document.getElementById('db_port');
    function updateDatabaseFields() {
      const sqlite = driver.value === 'sqlite';
      serverFields.hidden = sqlite;
      sqliteFields.hidden = !sqlite;
      serverFields.querySelectorAll('input').forEach(input => input.disabled = sqlite);
      port.value = driver.value === 'postgresql' ? '5432' : '3306';
    }
    driver.addEventListener('change', updateDatabaseFields);
    updateDatabaseFields();
  </script>
</main>
{% endblock %}
